# Copy this file to .env and fill in real values.
# Generate a strong SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-me-with-a-long-random-string
FLASK_CONFIG=prod
DATABASE_URL=sqlite:////app/instance/quorum.db
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=26214400
TIMEZONE=America/Chicago

# Set to true only when serving Quorum over HTTPS. Leave blank/false for
# plain-HTTP LAN deployments, otherwise browsers will drop the session
# cookie and logins will fail with "CSRF session token is missing".
SESSION_COOKIE_SECURE=false

# Church identity (day-to-day name and legal name from bylaws).
CHURCH_DISPLAY_NAME=Connection Church
CHURCH_LEGAL_NAME=Tri-City Assembly of God
